# ca82796fd1cedb392bf2961728d52d5e299a81bc4ffd2d300cbcab10b7fc4260 Elan 2.0.0-beta3 valid

function pad(d as String, p as String, s as String) returns String
  # d: L or R for pad left or right
  # p: output string pattern of length and pad characters
  # s: input string
  variable sR set to s
  variable lp set to p.length()
  if lp > s.length() then
    if d.upperCase().equals("L") then
      assign sR to p + s
      variable lps set to sR.length()
      assign sR to sR.subString(lps - lp, lps)
    else
      if d.upperCase().equals("R") then
        assign sR to s + p
        assign sR to sR.subString(0, lp)
      end if
    end if
  end if
  return sR
end function

test test_pad
  variable sp10 set to "          "
  variable hy8 set to "---------"
  assert pad("L", "0000", "34") evaluates to "0034"
  assert pad("l", sp10, "Monday") evaluates to "    Monday"
  assert pad("r", hy8, "34") evaluates to "34-------"
  assert pad("R", sp10, "Tuesday") evaluates to "Tuesday   "
  assert pad("", sp10, "Tue") evaluates to "Tue"
end test
